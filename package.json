{
  "name": "want-wallpapers",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "preview": "bun run --cwd frontend preview",
    "check": "bun run --cwd frontend check",
    "test": "bun run --cwd frontend test",
    "test:ui": "bun run --cwd frontend test:ui",
    "catalog:pull": "bun run --cwd frontend catalog:pull",
    "catalog:add": "bun run --cwd frontend catalog:add"
  },
  "trustedDependencies": [],
  "overrides": {
    "sharp": "0.35.5",
    "@grpc/grpc-js": "1.14.5",
    "http-cache-semantics": "4.3.0",
    "esbuild": "0.25.12"
  }
}
