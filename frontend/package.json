{
  "name": "@want-wallpapers/frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "sync:previews": "bun scripts/sync-previews.ts",
    "build": "bun run sync:previews && astro build && bun scripts/csp-hashes.ts && bun scripts/verify-build.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test:ui": "bunx --bun playwright test",
    "catalog:pull": "bun scripts/catalog-pull.ts",
    "catalog:add": "bun scripts/catalog-add.ts",
    "test": "bun test tests/catalog-search.test.ts tests/search-filters.test.ts tests/catalog-add.test.ts tests/privacy.test.ts tests/privacy-runtime.test.ts && bun tests/privacy-sdk.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "astro": "^5.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "lucide-react": "^1.50.0",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.14.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.2.0",
    "@types/lunr": "^2.3.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
