---
import type { Locale } from '../data/catalog';
import { interfaceCopy } from '../data/interface-copy';
import type { AdvertisementPlacement } from '../lib/advertising-providers';
const { locale, placement } = Astro.props as { locale: Locale; placement: AdvertisementPlacement };
const label = interfaceCopy[locale].advertisement;
---
<div class="public-advertisements" data-advertisement-placement={placement} data-advertisement-label={label}></div>
