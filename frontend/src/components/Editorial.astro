---
import CollectionStories from './CollectionStories.astro';
import { editorialCopy, collectionStories } from '../data/editorial';
import { copy, localPath } from '../data/copy';
import { collections, tagLabels, getCollection, getCollectionWallpapers, type Locale, type Collection, type Wallpaper } from '../data/catalog';
import { previewData, type WallpaperVariant } from '../data/previews';
type Props = { embedded?: boolean; locale: Locale; collection?: Collection; wallpaper?: Wallpaper; variants?: Record<'desktop' | 'mobile', WallpaperVariant> };
const { locale, collection, wallpaper, variants, embedded = false } = Astro.props;
const text = editorialCopy[locale];
const storyCollection = collection ?? (wallpaper ? getCollection(wallpaper.collection) : undefined);
const stories = (storyCollection ? [storyCollection] : collections).map((item) => {
  const paragraphs = collectionStories[item.slug]?.[locale];
  if (!paragraphs?.length) throw new Error(`Missing collection story: ${item.slug}/${locale}`);
  return { item, paragraphs: paragraphs };
});
const designs = wallpaper ? [wallpaper] : collection ? getCollectionWallpapers(collection.slug) : [];
const dimensions = await Promise.all(designs.map(async (item) => ({ item, sizes: variants ?? { desktop: await previewData(item, 'desktop'), mobile: await previewData(item, 'mobile') } })));
const topics = [...new Set(designs.flatMap((item) => item.tags))];
---
{!storyCollection && <CollectionStories locale={locale} />}
<section class:list={[!embedded && "shell section-space", embedded && "wallpaper-context"]} data-editorial>
  <div class="reading-surface">
    <h2 class="section-title" id={storyCollection ? "collection-story" : undefined}>{storyCollection ? text.story : text.license}</h2>
    <div class="reading-sections">
      {storyCollection && stories.map(({ item, paragraphs }) => <section class="reading-section reading-section-wide"><h3><a href={localPath(locale, `/collections/${item.slug}/`)}>{item.title[locale]}</a></h3><div class="long-copy" data-long-copy>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>)}
      {collection && <section class="reading-section reading-section-wide"><h3>{text.works}</h3><ul class="work-index">{designs.map((item) => <li data-listing-wallpaper={item.id}><a href={localPath(locale, `/wallpapers/${item.slug}/`)}><span class="work-number">{item.number.toLocaleString(locale)}</span><span>{item.title[locale]}<small>{item.description[locale]}</small></span></a></li>)}</ul></section>}
      {dimensions.length > 0 && <section class="reading-section reading-section-wide"><h3>{text.sizes}</h3><p>{text.files}</p><dl class="format-index mt-4">{dimensions.map(({ item, sizes }) => <div data-listing-wallpaper={collection ? item.id : undefined}><dt>{item.title[locale]}</dt><dd>{copy[locale].desktop} {sizes.desktop.originalWidth} × {sizes.desktop.originalHeight}</dd><dd>{copy[locale].mobile} {sizes.mobile.originalWidth} × {sizes.mobile.originalHeight} · PNG</dd></div>)}</dl></section>}
      <section class="reading-section reading-note"><h3>{text.license}</h3><p>{text.licenseText} <a href={localPath(locale, '/license/')}>{copy[locale].license}</a></p></section>
      {topics.length > 0 && <nav class="reading-section" aria-label={text.topics}><h3>{text.topics}</h3><div class="topic-links">{topics.map((tag) => <a data-listing-tag={collection ? tag : undefined} href={localPath(locale, `/search/?q=${encodeURIComponent(tagLabels[tag][locale])}`)}>{tagLabels[tag][locale]}</a>)}</div></nav>}
    </div>
  </div>
</section>
