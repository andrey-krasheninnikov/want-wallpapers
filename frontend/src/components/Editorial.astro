---
import { guideCopy } from '../data/editorial';
import { copy, localPath } from '../data/copy';
import { tagLabels, getCollectionWallpapers, type Locale, type Collection, type Wallpaper } from '../data/catalog';
import { previewData, type WallpaperVariant } from '../data/previews';
type Props = { locale: Locale; collection?: Collection; wallpaper?: Wallpaper; variants?: Record<'desktop' | 'mobile', WallpaperVariant> };
const { locale, collection, wallpaper, variants } = Astro.props;
const text = guideCopy[locale];
const designs = wallpaper ? [wallpaper] : collection ? getCollectionWallpapers(collection.slug) : [];
const dimensions = await Promise.all(designs.map(async (item) => ({ item, sizes: variants ?? { desktop: await previewData(item, 'desktop'), mobile: await previewData(item, 'mobile') } })));
const topics = [...new Set(designs.flatMap((item) => item.tags))];
---
<section class="shell section-space" data-editorial>
  <div class="editorial">
    <h2>{text.title}</h2>
    {collection && <><h3>{text.about}</h3><p>{collection.description[locale]}</p><ul>{designs.map((item) => <li><a href={localPath(locale, `/wallpapers/${item.slug}/`)}>{item.title[locale]}</a> — {item.description[locale]}</li>)}</ul></>}
    {wallpaper && <p>{wallpaper.description[locale]}</p>}
    <p>{text.paragraphs[0]}</p>
    <h3>{text.formats}</h3>
    {dimensions.length > 0 && <><p>{text.sizes}</p><ul>{dimensions.map(({ item, sizes }) => <li>{item.title[locale]}: {copy[locale].desktop} {sizes.desktop.originalWidth} × {sizes.desktop.originalHeight}; {copy[locale].mobile} {sizes.mobile.originalWidth} × {sizes.mobile.originalHeight} · PNG</li>)}</ul></>}
    <p>{text.paragraphs[1]}</p>
    <h3>{text.install}</h3><p>{text.paragraphs[2]}</p>
    <h3>{text.license}</h3><p>{text.paragraphs[3]} <a href={localPath(locale, '/license/')}>{copy[locale].license}</a></p>
    {topics.length > 0 && <nav aria-label={text.topics}><h3>{text.topics}</h3><p>{topics.map((tag, index) => <><a href={localPath(locale, `/search/?q=${encodeURIComponent(tagLabels[tag][locale])}`)}>{tagLabels[tag][locale]}</a>{index < topics.length - 1 ? ' · ' : ''}</>)}</p></nav>}
  </div>
</section>
