---
import Base from '../layouts/Base.astro';
import SupportText from './SupportText.astro';
import FeedbackForm from './FeedbackForm';
import { Mail } from 'lucide-react';
import { copy } from '../data/copy';
import { interfaceCopy } from '../data/interface-copy';
import type { Locale } from '../data/catalog';
type Props = { locale: Locale };
const { locale } = Astro.props;
const ui = copy[locale];
---
<Base locale={locale} title={ui.feedbackTitle} description={ui.feedbackText} path="/feedback/">
  <section class="shell feedback-layout" aria-label={ui.feedback}>
    <div class="feedback-copy"><h1 class="display-title">{ui.feedbackTitle}</h1><p class="mt-6 max-w-lg text-base leading-relaxed text-muted-foreground">{ui.feedbackText}</p>
      <div class="feedback-direct"><Mail aria-hidden="true" /><h2 class="text-lg font-semibold">{interfaceCopy[locale].feedbackDirect}</h2><a class="inline-flex min-h-11 items-center text-base text-link wrap-anywhere" href="mailto:wallpapers@want.foundation">wallpapers@want.foundation</a><p class="max-w-sm text-sm leading-relaxed text-muted-foreground">{interfaceCopy[locale].feedbackDirectHint}</p></div>
    </div>
    <div class="min-w-0"><FeedbackForm locale={locale} client:load /><noscript><p class="rounded-lg bg-card p-6 text-muted-foreground">{interfaceCopy[locale].javascriptRequired} <a class="text-link underline" href="mailto:wallpapers@want.foundation">wallpapers@want.foundation</a></p></noscript></div>
    <div class="feedback-support"><SupportText locale={locale} page="feedback" /></div>
  </section>
</Base>
