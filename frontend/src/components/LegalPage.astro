---
import Base from '../layouts/Base.astro';
import SupportText from './SupportText.astro';
import { Crumbs } from './Gallery';
import OwnerContact from './OwnerContact';
import { legalPage, type LegalKey } from '../data/legal';
import { copy, localPath } from '../data/copy';
import type { Locale } from '../data/catalog';
type Props = { locale: Locale; page: LegalKey };
const { locale, page } = Astro.props;
const legal = legalPage(locale, page);
---
<Base locale={locale} title={legal.title} description={legal.intro} path={`/${page}/`}>
  <article class="shell prose legal-surface">
    <header class="reading-intro"><Crumbs label={legal.title} items={[{ href: localPath(locale), title: copy[locale].home }, { title: legal.title }]} /><h1 class="display-title mt-6">{legal.title}</h1><p>{legal.intro}</p></header>
    <div class="reading-sections">{legal.sections.map((section) => <section class="reading-section legal-section"><h2>{section.heading}</h2><div>{section.owner && <OwnerContact locale={locale} />}<div class="long-copy" data-long-copy>{section.paragraphs.map((paragraph) => <p>{paragraph === 'wallpapers@want.foundation' ? <a href="mailto:wallpapers@want.foundation">{paragraph}</a> : paragraph}</p>)}</div></div></section>)}</div>
    {(page === 'contact' || page === 'license' || page === 'terms' || page === 'cookies') && <SupportText locale={locale} page={page} />}
  </article>
</Base>
