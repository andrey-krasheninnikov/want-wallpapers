---
import '@want-foundation/desyst-foundation/styles.css';
import '@want-foundation/desyst-foundation/fonts.css';
import '../styles/global.css';
import logo from '@want-foundation/desyst-foundation/assets/wallpapers.svg?url';
import ThemeScript from '../components/ThemeScript.astro';
const { title } = Astro.props;
---
<!doctype html>
<html lang="ru" dir="ltr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#141414" />
    <ThemeScript />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · Want Wallpapers</title>
    <link rel="icon" type="image/svg+xml" href={logo} />
  </head>
  <body class="min-h-dvh bg-background text-foreground"><slot /></body>
</html>
