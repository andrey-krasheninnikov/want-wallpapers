---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/manrope';
import '@fontsource-variable/onest';
import '../styles/global.css';
import logoUrl from '../../assets/logo.svg?url';
import Header from '../components/Header';
import Footer from '../components/Footer';
import CookieConsent from '../components/CookieConsent';
import { localPath } from '../data/copy';
import { interfaceCopy } from '../data/interface-copy';
import { locales, type Locale } from '../data/catalog';
import { isAnalyticsConfigured } from '../lib/privacy';

type Props = { locale: Locale; title: string; description: string; path: string; image?: string; schema?: object; noindex?: boolean };
const { locale, title, description, path, image, schema, noindex = false } = Astro.props;
const canonical = new URL(localPath(locale, path), Astro.site);
const fullTitle = `${title} | Want Wallpapers`;
const imageUrl = image ? new URL(image, Astro.site) : undefined;
const languageTag = locale === 'zh-cn' ? 'zh-CN' : locale === 'pt-br' ? 'pt-BR' : locale;
const analyticsAvailable = isAnalyticsConfigured();
---
<!doctype html>
<html lang={languageTag} class="dark" data-public-background>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141414" />
    {path.startsWith('/wallpapers/') && <ClientRouter fallback="swap" />}
    <style is:inline>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
    {path.startsWith('/wallpapers/') && <link rel="expect" href="#wallpaper-view" blocking="render" />}
    {path.startsWith('/wallpapers/') && <script is:inline data-astro-rerun>
      document.documentElement.dataset.wallpaperVariant = new URLSearchParams(location.search).get('variant') === 'mobile' ? 'mobile' : 'desktop';
    </script>}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={path === "/search/" ? "noindex, follow" : "noindex"} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="describedby" type="text/plain" href={new URL('/llms.txt', Astro.site).href} />
    {!noindex && locales.map((lang) => <link rel="alternate" hreflang={lang === 'zh-cn' ? 'zh-CN' : lang === 'pt-br' ? 'pt-BR' : lang} href={new URL(localPath(lang, path), Astro.site).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localPath('en', path), Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Want Wallpapers" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={languageTag.replace('-', '_')} />
    {imageUrl && <meta property="og:image" content={imageUrl.href} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={logoUrl} />
    <noscript><style is:inline>[data-slot="accordion-content"] { display: block !important; } .device-controls { display: none !important; }</style></noscript>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />}
  </head>
  <body data-locale={locale}>
    <div class="page-background" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{interfaceCopy[locale].skip}</a>
    <Header locale={locale} path={path} logo={logoUrl} client:load transition:persist="header" />
    <Fragment set:html={"<!--email_off-->"} /><main id="main" tabindex="-1"><slot /></main><Fragment set:html={"<!--/email_off-->"} />
    <Fragment set:html={"<!--email_off-->"} /><Footer locale={locale} logo={logoUrl} /><Fragment set:html={"<!--/email_off-->"} />
    <div id="feedback-root" transition:persist="feedback-root"></div>
    <script>
      import { initCollectionCovers } from '../lib/collection-cover-player';
      import { initPageMotion } from '../lib/page-motion';
      import { initGalleryEffects } from '../lib/gallery-effects';
      let cleanup = () => {};
      function initializePage() {
        cleanup();
        const motion = initPageMotion();
        const covers = initCollectionCovers();
        const effects = initGalleryEffects();
        cleanup = () => { motion(); covers(); effects(); };
      }
      document.addEventListener('astro:before-swap', () => cleanup());
      document.addEventListener('astro:page-load', initializePage);
      initializePage();
      import { initFeedbackDialog } from '../lib/feedback-dialog';
      import { initWallpaperNavigation } from '../lib/wallpaper-navigation';
      initWallpaperNavigation();
      const locale = document.body.dataset.locale as import('../data/catalog').Locale;
      initFeedbackDialog(locale);
    </script>
    <CookieConsent locale={locale} analyticsAvailable={analyticsAvailable} client:load transition:persist="cookies" />
  </body>
</html>
