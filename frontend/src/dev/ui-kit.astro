---
import '@fontsource-variable/manrope';
import '@fontsource-variable/onest';
import '../styles/global.css';
import logo from '../../assets/logo.svg?url';
import UiKit from './UiKit';
import { wallpapers } from '../data/catalog';
import { wallpaperCard } from '../lib/view-models';
const item = await wallpaperCard(wallpapers[0]!, 'en');
---
<!doctype html>
<html lang="en" class="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>UI kit | Want Wallpapers</title><link rel="icon" href={logo} type="image/svg+xml" /></head>
  <body><a class="skip-link" href="#main">Skip to content</a><header class="shell py-6"><a href="/" class="inline-flex min-h-11 items-center gap-3 font-semibold"><img src={logo} width="32" height="32" alt="" />Want Wallpapers</a></header>
    <main id="main" class="shell pb-12" tabindex="-1"><div class="page-heading"><h1 class="display-title">UI kit</h1><p class="mt-4 max-w-2xl text-muted-foreground">Shared tokens, source-owned components and working examples. This page is available only in development.</p></div><UiKit item={item} client:load /></main>
  </body>
</html>
