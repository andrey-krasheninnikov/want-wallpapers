[Unit]
Description=Want Wallpapers collection distribution
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 -I /usr/local/lib/wallpapers-deploy/scripts/distribution-export.py
ExecStart=/usr/bin/python3 -I /usr/local/lib/wallpapers-deploy/scripts/distribution-run.py --once
ExecStopPost=/usr/bin/python3 -I /usr/local/lib/wallpapers-deploy/scripts/distribution-run.py cleanup
TimeoutStartSec=240
TimeoutStopSec=25
CPUQuota=20%
MemoryMax=128M
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/want-deploy/wallpapers/requests /var/lib/want-wallpapers/publications
