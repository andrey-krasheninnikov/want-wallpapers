APP_IMAGE=want-wallpapers:local
SECRETS_DIR=/etc/want-wallpapers/secrets
ADMIN_USERNAME=admin
TRAEFIK_NETWORK=wallpapers-proxy
# Set actual Traefik addresses; add Cloudflare CIDRs only when it forwards the trusted chain. Never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=172.20.0.2/32

RECAPTCHA_PROJECT_ID=want-wallpapers
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
