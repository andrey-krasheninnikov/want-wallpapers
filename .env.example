# Backend environment; use external files for secrets.
APP_ENV=development
SITE_URL=http://localhost:4321
BIND_ADDR=127.0.0.1:8080
STATIC_DIR=frontend/dist
DATABASE_URL_FILE=/absolute/path/outside-repository/database_url
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_FILE=/absolute/path/outside-repository/admin_password_hash
ADMIN_TOTP_SECRET_FILE=/absolute/path/outside-repository/admin_totp_secret
CATALOG_API_TOKEN_FILE=/absolute/path/outside-repository/catalog_api_token
TRUSTED_PROXY_CIDRS=

# Development may disable reCAPTCHA; production always requires it.
RECAPTCHA_ENABLED=false
RECAPTCHA_PROJECT_ID=want-wallpapers
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/google_application_credentials.json
