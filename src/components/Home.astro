---
import Base from '../layouts/Base.astro';
import CollectionCard from './CollectionCard.astro';
import WallpaperCard from './WallpaperCard.astro';
import { collections, previewUrl, wallpapers, type Locale } from '../data/catalog';
import { copy, localPath } from '../data/copy';
type Props = { locale: Locale };
const { locale } = Astro.props;
const ui = copy[locale];
const hero = wallpapers.find((item) => item.collection === 'contours-of-silence' && item.number === 1)!;
const highlights = [wallpapers[0], wallpapers[4], wallpapers[15], wallpapers[18], wallpapers[20], wallpapers[22]].filter(Boolean);
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Want Wallpapers', url: new URL(localPath(locale), Astro.site).href,
  potentialAction: { '@type': 'SearchAction', target: new URL(localPath(locale, '/search/') + '?q={search_term_string}', Astro.site).href, 'query-input': 'required name=search_term_string' } };
---
<Base locale={locale} title={ui.heroTitle} description={ui.heroText} path="/" image={previewUrl(hero, 'desktop')} schema={schema}>
  <section class="hero shell">
    <div class="hero-layout">
      <div class="hero-copy"><span class="eyebrow">{ui.heroEyebrow}</span><h1>{ui.heroTitle}</h1><p>{ui.heroText}</p><a class="button button-primary" href="#collections">{ui.explore}</a></div>
      <a class="hero-art" href={localPath(locale, `/wallpapers/${hero.slug}/`)} aria-label={hero.title[locale]}>
        <img src={previewUrl(hero, 'desktop')} alt={hero.description[locale]} width="1280" height="800" fetchpriority="high" />
        <span class="hero-caption">{ui.featured}: {hero.title[locale]}</span>
      </a>
    </div>
  </section>
  <section class="section shell" id="collections"><h2 class="section-title">{ui.allCollections}</h2><p class="section-intro">{ui.allCollectionsText}</p>
    <div class="collection-grid">{collections.map((collection) => <CollectionCard collection={collection} locale={locale} />)}</div>
  </section>
  <section class="section shell"><h2 class="section-title">{ui.latest}</h2><div class="wallpaper-grid">{highlights.map((wallpaper) => <WallpaperCard wallpaper={wallpaper} locale={locale} />)}</div>
    <div class="section-end"><a class="text-link" href={localPath(locale, '/search/')}>{ui.viewAll} <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>
