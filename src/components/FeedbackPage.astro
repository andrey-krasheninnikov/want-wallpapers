---
import Base from '../layouts/Base.astro';
import { copy } from '../data/copy';
import type { Locale } from '../data/catalog';
type Props = { locale: Locale };
const { locale } = Astro.props;
const ui = copy[locale];
---
<Base locale={locale} title={ui.feedbackTitle} description={ui.feedbackText} path="/feedback/">
  <div class="shell page-head"><h1>{ui.feedbackTitle}</h1><p>{ui.feedbackText}</p></div>
  <div class="shell" id="feedback-page" data-locale={locale}>
    <p class="region-note">{ui.regionUnavailable}</p>
    <form class="feedback-panel regional-only" id="feedback-form">
      <div class="field"><label for="feedback-topic">{ui.topic}</label><input id="feedback-topic" name="topic" maxlength="100" required /></div>
      <div class="field"><label for="feedback-message">{ui.message}</label><textarea id="feedback-message" name="message" minlength="5" maxlength="2000" required></textarea></div>
      <div class="field"><label for="feedback-email">{ui.emailOptional}</label><input id="feedback-email" name="email" type="email" maxlength="254" autocomplete="email" /></div>
      <button class="button button-primary" type="submit">{ui.feedbackSubmit}</button><p class="status" id="feedback-status" role="status"></p>
    </form>
  </div>
  <script>import '../lib/feedback-client';</script>
</Base>
