---
import Base from '../layouts/Base.astro';
import FeedbackForm from './FeedbackForm';
import { copy } from '../data/copy';
import { interfaceCopy } from '../data/interface-copy';
import type { Locale } from '../data/catalog';
type Props = { locale: Locale };
const { locale } = Astro.props;
const ui = copy[locale];
---
<Base locale={locale} title={ui.feedbackTitle} description={ui.feedbackText} path="/feedback/">
  <div class="shell page-heading"><h1 class="display-title max-w-4xl">{ui.feedbackTitle}</h1><p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">{ui.feedbackText}</p></div>
  <section class="shell" aria-label={ui.feedback}><FeedbackForm locale={locale} client:load /><noscript><p class="max-w-2xl rounded-lg border p-6 text-muted-foreground">{interfaceCopy[locale].javascriptRequired} <a class="text-link underline" href="mailto:wallpapers@want.foundation">wallpapers@want.foundation</a></p></noscript></section>
</Base>
