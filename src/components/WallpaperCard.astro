---
import { getCollection, previewUrl, type Locale, type Wallpaper } from '../data/catalog';
import { localPath } from '../data/copy';
type Props = { wallpaper: Wallpaper; locale: Locale };
const { wallpaper, locale } = Astro.props;
const collection = getCollection(wallpaper.collection);
---
<article class="wallpaper-card">
  <a class="wallpaper-card-image" href={localPath(locale, `/wallpapers/${wallpaper.slug}/`)} aria-label={wallpaper.title[locale]}>
    <img src={previewUrl(wallpaper, 'desktop')} alt={wallpaper.description[locale]} width="1280" height="800" loading="lazy" />
  </a>
  <div class="wallpaper-card-text">
    <div><h3><a href={localPath(locale, `/wallpapers/${wallpaper.slug}/`)}>{wallpaper.title[locale]}</a></h3><p>{collection?.title[locale]}</p></div>
    <span class="card-index">{String(wallpaper.number).padStart(2, '0')}</span>
  </div>
</article>
